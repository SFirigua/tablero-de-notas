# URL del servicio de métricas consumido por /dashboard (PUBLIC_METRICS_URL).
# Única variable de configuración: el código nunca contiene la URL hardcodeada.
#
# Ejemplos:
#   Local (servicio externo):  http://localhost:3001/metrics
#   Local (Django):            http://localhost:8000/api/internal/notes-status/
#   AWS:                       https://<API_GATEWAY>/metrics
PUBLIC_METRICS_URL=http://localhost:8000/api/internal/notes-status/
