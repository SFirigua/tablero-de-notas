# URL del servicio de métricas consumido por /dashboard (PUBLIC_METRICS_URL).
# Única variable de configuración: el código nunca contiene la URL hardcodeada.
#
# Ejemplos:
#   Local con SAM (recomendado):  http://localhost:3001/metrics
#     -> sam local start-api --docker-network tablero-net --port 3001
#   Local sin SAM (Django):       http://localhost:8000/api/internal/notes-status/
#   AWS:                          https://<API_GATEWAY>/Prod/metrics
PUBLIC_METRICS_URL=http://localhost:3001/metrics
