# --- Django --- #
DJANGO_SECRET_KEY=cambia-esta-clave-en-produccion
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend

# --- PostgreSQL --- #
POSTGRES_DB=tablero
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# --- CORS --- #
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://frontend:3000

# --- Frontend --- #
# URL del servicio de métricas consumido por /dashboard (se hornea en la build).
# Local con SAM: http://localhost:3001/metrics | AWS: https://<API_GATEWAY>/Prod/metrics
PUBLIC_METRICS_URL=http://localhost:3001/metrics
