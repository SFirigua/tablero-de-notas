# --- Django --- #
DJANGO_SECRET_KEY=cambia-esta-clave-en-produccion
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
# Zona horaria de exibición en Admin/serializers (almacenamiento interno en UTC).
DJANGO_TIME_ZONE=America/Bogota

# --- PostgreSQL --- #
POSTGRES_DB=tablero
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# --- CORS --- #
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://frontend:3000

# --- API interna (Lambda -> backend) --- #
# Token compartido que la Lambda envía en la cabecera X-Internal-Token.
# Local: debe coincidir con INTERNAL_API_TOKEN de aws/env.local.json.
# AWS: debe coincidir con el parámetro InternalApiToken del stack SAM (y con
# el .env del backend en EC2). Cambiar en entornos reales.
INTERNAL_API_TOKEN=dev-internal-token

# --- Frontend --- #
# URL del servicio de métricas consumido por /dashboard (se hornea en la build).
# Local con SAM: http://localhost:3001/metrics | AWS: https://<API_GATEWAY>/Prod/metrics
PUBLIC_METRICS_URL=http://localhost:3001/metrics
